# واجهةُ العميل — متغيّراتُ البيئة
#
# انسخه إلى `.env.local` (وهو مُستثنى في `.gitignore`).
#
# ⚠️ و`NEXT_PUBLIC_` تعني **يصل المتصفّح**. فلا يوضع هنا سرٌّ أبداً:
# مفتاحُ الإدارة، ولا كلمةُ قاعدة، ولا مفتاحُ مزوّدِ دفع.

# عنوانُ الخلفيّة.
NEXT_PUBLIC_MEDUSA_URL=http://localhost:9000

# مفتاحُ النشر (publishable key) — **علنيٌّ بتصميمه**: يعيش في المتصفّح
# ويقول للخادم «أيُّ قناةِ بيعٍ أنا»، ولا يمنح صلاحيةَ قراءةٍ أو كتابةٍ
# لشيءٍ خاصّ. ويُقرأ من البيئة لا يُكتب في الكود لأن كلَّ نشرةٍ (محلّية،
# تجريبية، إنتاج) لها مفتاحُها ومتجرُها.
NEXT_PUBLIC_MEDUSA_PK=pk_ضع_مفتاحك_هنا
