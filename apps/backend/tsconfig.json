{
  "compilerOptions": {
    "target": "ES2021",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2021"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "outDir": "./.medusa/server",
    "baseUrl": ".",
    "paths": { "@zadim/*": ["./src/*"] }
  },
  "include": ["src", "medusa-config.ts"],
  "exclude": ["node_modules", ".medusa", "dist"]
}
