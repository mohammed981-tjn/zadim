# ---- قاعدة البيانات (إلزامي) ----
DATABASE_URL=postgres://zadim:zadim@localhost:5432/zadim

# مخطَّطُنا داخل القاعدة. لا يُترك `public` أبداً (ADR-009).
#
# 🔴 **ولا يكفي ضبطُه هنا.** هجراتُ Medusa الأساسية تكتب SQL خاماً
# بأسماءٍ غيرِ مؤهَّلة، فتذهب حيث يقول `search_path` — وافتراضُه
# `"$user", public`. فيلزم على القاعدة مرّةً واحدة:
#
#   alter role <الدور> in database <القاعدة> set search_path = zadim, public;
#
# وبدونه ينزل ١٦٧ جدولاً في `public` و٢٢ هنا، ثم يسقط الإقلاع برسالةٍ
# لا تدلّ على السبب. و`migrate-once.ts` يرفض الهجرةَ قبل أن يقع ذلك.
DATABASE_SCHEMA=zadim

# ---- أسرار (إلزامية في الإنتاج — لا تُدفع قيمُها الحقيقية أبداً) ----
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# ---- أصول مسموحة ----
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000

# ---- اختياري: Redis للطوابير والأحداث. بدونه يعمل محلياً بالذاكرة ----
REDIS_URL=

# ---- الطبقة السعودية (تُملأ عند مرحلتها) ----
# MOYASAR_SECRET_KEY=
# ZATCA_PROVIDER_KEY=

# تعطيلُ لوحة الإدارة — لنُسَخ العامل التي لا تخدم واجهة
MEDUSA_ADMIN_DISABLED=false

# ── النشر (انظر docs/10-deployment.md) ───────────────────────────
#
# 🔴 عنوانُ الخادم كما يراه **العالمُ الخارجيّ** — لا `localhost`.
# ومنه تُبنى روابطُ صور المنتجات المخزَّنة في القاعدة. وبلا ضبطِه في
# الإنتاج **لا يُقلع الخادم** عمداً: مزوّدُ الملفّات الافتراضيّ يكتب
# `http://localhost:9000/static`، فتُحفظ روابطُ صورٍ لا يفتحها زائرٌ
# أبداً — ويبقى الخطأُ في البيانات بعد إصلاح الإعداد.
MEDUSA_BACKEND_URL=http://localhost:9000

# مجلَّدُ الرفع. ⚠️ يجب أن يكون على **قرصٍ دائم** في الإنتاج، وإلا
# فُقدت كلُّ الصور مع كل نشرة.
UPLOAD_DIR=static
